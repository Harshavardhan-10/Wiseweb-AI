# ==================================================
# Wiseweb-AI environment configuration
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ==================================================

# --- Application ---
APP_NAME=Wiseweb-AI
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173

# --- Database (PostgreSQL) ---
# Local: postgresql+psycopg://wisewebai:wisewebai@localhost:5432/wisewebai
DATABASE_URL=postgresql+psycopg://wisewebai:wisewebai@localhost:5432/wisewebai

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI provider ---
# AI_PROVIDER: openai | anthropic | mock
# Set AI_PROVIDER=mock to run without any external AI API.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=60
AI_MAX_CONTEXT_CHARS=24000
AI_ENABLED=true

# --- Crawler ---
CRAWLER_MAX_PAGES=50
CRAWLER_MAX_DEPTH=3
CRAWLER_TIMEOUT=15
CRAWLER_CONCURRENCY=4
CRAWLER_DELAY=0.25
CRAWLER_MAX_PAGE_BYTES=5242880
CRAWLER_USER_AGENT=WisewebAI-Bot/1.0 (+https://wiseweb-ai.local; passive website analysis)

# --- Demo ---
DEMO_USER_EMAIL=demo@wiseweb-ai.local
DEMO_USER_PASSWORD=demopass123
SEED_DEMO=true
# DEV-ONLY: allow scanning localhost/private targets (e.g. the demo site on
# http://localhost:8001) from the UI. Relaxes SSRF protection — never
# enable in production.
ALLOW_LOCALHOST_SCANS=false
